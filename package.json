{
  "name": "spotto",
  "main": "index.js",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^23.4.0",
    "@react-native-firebase/auth": "^23.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@stripe/stripe-react-native": "0.64.0",
    "@supabase/supabase-js": "^2.112.4",
    "@xmartlabs/react-native-line": "^6.0.1",
    "base64-arraybuffer": "^1.0.2",
    "buffer": "^6.0.3",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.0",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "^57.0.21",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "firebase": "^11.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eas-cli": "^24.7.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "bash -c 'source scripts/android-jdk.sh && expo run:android'",
    "android:device": "bash scripts/run-android-device.sh",
    "android:device:build": "SKIP_METRO=1 bash scripts/run-android-device.sh",
    "android:devices": "adb devices -l",
    "android:clean-native": "rm -rf android/app/.cxx android/app/build android/build node_modules/react-native-worklets/android/.cxx node_modules/react-native-screens/android/.cxx node_modules/react-native-reanimated/android/.cxx && cd android && ./gradlew --stop",
    "eas:android:dev": "npx eas-cli build --platform android --profile development",
    "eas:android:preview": "npx eas-cli build --platform android --profile preview",
    "ios": "bash scripts/run-ios-sim.sh",
    "ios:device": "expo run:ios --device",
    "ios:expo": "expo run:ios --device \"iPhone 17\"",
    "web": "expo start --web",
    "api": "node server/index.mjs",
    "api:start": "npm --prefix server start",
    "seed:qa": "node scripts/seed-mock-qa.mjs",
    "delete:qa": "node scripts/delete-mock-qa.mjs",
    "seed:store": "node scripts/seed-store-demo.mjs",
    "cleanup:mock": "node scripts/cleanup-mock-and-test.mjs",
    "check:firebase": "node scripts/check-firebase-build.cjs",
    "ios:clean": "rm -rf .expo node_modules/.cache ios/build && bash scripts/run-ios-sim.sh",
    "clean:metro": "rm -rf .expo node_modules/.cache node_modules/react-native-svg && npm install react-native-svg@15.15.4 --save-exact && npx expo start -c",
    "postinstall": "node scripts/patch-line-bot-prompt.cjs && node scripts/patch-maps-user-location.cjs"
  },
  "private": true
}

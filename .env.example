# Google Maps Platform API Key（Maps SDK for Android/iOS / Places）
# ハードコード禁止。Google Cloud Console でキーを発行して設定。
# Android 実機 / EAS Build で必須。未設定だと「API key not found」でクラッシュします。
#
# ローカル: この .env に設定（npx expo run:android 前に必要）
# EAS Build:
#   - プロジェクトに .easignore があり .env を含める（推奨・ローカルと同じキーを使う）
#   - または: eas secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value <YOUR_KEY> --type string
#   - エイリアス GOOGLE_MAPS_API_KEY でも可
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=

# 通報の補助通知（本体は Supabase public.reports へ INSERT）
# apply_reports.sql / migrations/20260346120000_reports.sql を先に適用してください。
# 任意: 保存後に API / Slack へも転送（失敗しても DB 保存は成功扱い）
# 1) 自前API（サーバー側で Slack / メールへ転送）
EXPO_PUBLIC_REPORT_API_URL=
# 2) Slack Incoming Webhook
# https://api.slack.com/messaging/webhooks
EXPO_PUBLIC_REPORT_WEBHOOK_URL=

# バックエンド（server/index.mjs）の公開 URL。個別 URL が空ならこのベースから組み立てます。
# ローカル例: npm run api のあと http://localhost:8787
# Render 常時稼働例: https://spotto-api.onrender.com（手順: server/RENDER.md）
# 本番 EAS: 必ず HTTPS の本番 API URL を EAS Secret に設定
#   eas secret:create --name EXPO_PUBLIC_API_BASE_URL --value https://spotto-api.onrender.com
# 実機では localhost を Expo の LAN IP に自動置換します（要: 同じ Wi‑Fi + npm run api）。
# EXPO_PUBLIC_API_BASE_URL が空でも開発中は LAN IP:8787 を推定します。
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# --- ソーシャルログイン（ネイティブ SDK → Firebase Auth） ---
# Dev Client / 本番ビルドが必要（Expo Go ではネイティブモジュールが使えません）。
# 変更後は `npx expo prebuild` → `npx expo run:ios` / `run:android` で再ビルドしてください。
#
# Google Cloud Console > API とサービス > 認証情報
# - Web クライアント ID（必須: ネイティブでも ID トークン発行に使う）
# - iOS クライアント ID（bundle id = com.spotto.app）
# - Android クライアント ID（package = com.spotto.app + SHA-1）
#   SHA-1 例: keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android
# Firebase Console → Authentication → Sign-in method → Google を有効化
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
#
# Apple: ネイティブは Bundle ID（com.spotto.app）の App ID で Sign in with Apple を有効化。
# Firebase Console → Authentication → Sign-in method → Apple を有効化。
# ネイティブでは Services ID / リダイレクト URL は不要です。
#
# LINE Developers > LINE Login チャネルのチャネル ID（公開してよい）
# フロー: LINE SDK ログイン → POST /auth/line-firebase → Firebase Custom Token
#         → signInWithCustomToken → role=authenticated → Supabase
# iOS Info.plist: line3rdp.com.spotto.app / LSApplicationQueriesSchemes=lineauth2
# LINE Developers Console（既存設定を使用）:
#   - iOS bundle ID: com.spotto.app
#   - Android package name: com.spotto.app
#   - Android URL scheme: line3rdp.com.spotto.app
#   - Package signatures: debug/release の SHA-1
# サーバー必須: LINE_CHANNEL_SECRET + Firebase Admin（GOOGLE_APPLICATION_CREDENTIALS）
EXPO_PUBLIC_LINE_CHANNEL_ID=
# LINE / Firebase トークン交換 API（未設定時は EXPO_PUBLIC_API_BASE_URL）
EXPO_PUBLIC_AUTH_API_URL=

# --- Firebase Auth（Google / Apple / LINE / 電話番号） ---
# Firebase Console → プロジェクト設定 → マイアプリ から取得
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
#
# ネイティブ（iOS/Android）:
# 1) Firebase Console → Authentication → Sign-in method → 電話番号 / Google / Apple を有効化
# 2) 【必須】Authentication → Settings → SMS region policy で日本（JP）を許可
#    ※ 新規プロジェクトは既定で全リージョン拒否 → auth/operation-not-allowed になる
# 3) google-services.json（Android）と GoogleService-Info.plist（iOS）を
#    プロジェクトルートに配置（app.config.js が自動検出）
# 4) Authentication → 電話番号 → 「テスト用電話番号」に番号と固定コードを登録可能
# 5) Android は SHA-1 / SHA-256 を Firebase に登録（Play Integrity / SafetyNet）
# 6) `npx expo prebuild` 後に Dev Client を再ビルド（Expo Go では不可）
# 7) SMS 実送信は Blaze（従量課金）プランが必要な場合あり
#
# サーバー（必須: LINE Custom Token / role=authenticated claim / 退会）:
# Firebase Console → プロジェクト設定 → サービスアカウント → 新しい秘密鍵を生成
# JSON を server/secrets/firebase-adminsdk.json に置き（gitignore 済み）、次を設定:
# Firebase Admin（サーバー専用）
# ローカル: GOOGLE_APPLICATION_CREDENTIALS=server/secrets/firebase-adminsdk.json
# Render: FIREBASE_SERVICE_ACCOUNT_JSON に JSON を1行で設定（server/RENDER.md 参照）
# GOOGLE_APPLICATION_CREDENTIALS=server/secrets/firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# 起動: npm run api → ログに "Firebase Admin: OK" が出ること
#
# Supabase DB を使う場合（認証は Firebase）:
# Dashboard → Authentication → Third-party Auth → Firebase を有効化し project_id を設定
# SQL: supabase/apply_firebase_auth_uid.sql を適用（UID を text + auth.jwt()->>'sub'）
#
# 旧モック API / Supabase Phone / Supabase Auth は廃止
# EXPO_PUBLIC_PHONE_VERIFY_API_URL=
# EXPO_PUBLIC_PHONE_TEST_NUMBERS=

# Stripe（有料イベント決済）
# モード切替: test | live（未設定・不正値は安全側で test）
# アプリと API サーバーの両方で同じ EXPO_PUBLIC_STRIPE_MODE を読む
EXPO_PUBLIC_STRIPE_MODE=test
# Test 用（Dashboard 右上「Test mode」ON）
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_SECRET_KEY_TEST=
# Live 用（本番課金。誤課金に注意）
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_SECRET_KEY_LIVE=
# 互換用フォールバック（*_TEST / *_LIVE が空のときだけ使う）
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
EXPO_PUBLIC_STRIPE_PAYMENT_API_URL=
EXPO_PUBLIC_STRIPE_REFUND_API_URL=
EXPO_PUBLIC_STRIPE_CONFIRM_API_URL=
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.spotto.app
# ローカルでは EXPO_PUBLIC_API_BASE_URL=http://localhost:8787 と npm run api で十分です。
# 実機でも localhost のままで OK（アプリ側が LAN IP に置換）。API は 0.0.0.0:8787 で待受。

# 予約完了・キャンセル・リマインドメール（未設定時は API_BASE_URL/notify）
EXPO_PUBLIC_NOTIFY_API_URL=

# プッシュ通知送信 API（未設定時は API_BASE_URL/push）
# server/index.mjs の POST /push が device_push_tokens を解決して Expo Push へ転送します。
# SUPABASE_SERVICE_ROLE_KEY が必要です。未設定時は開発用コンソール出力のみ。
EXPO_PUBLIC_PUSH_API_URL=

# お問い合わせ（設定画面のフォーム）
# 宛先は Cloudflare Email Routing の support@spotto.fun（転送先ではない）。
EXPO_PUBLIC_SUPPORT_EMAIL=support@spotto.fun
EXPO_PUBLIC_CONTACT_API_URL=
# 添付画像は Supabase Storage の contact/ に保存し、公開 URL を本文に含めます。
# （バケット: event-images。supabase/apply_storage.sql を適用すること）

# ===== サーバー専用: お問い合わせメール送信 =====
# Resend または SendGrid のどちらか一方で可（Resend 優先）。
# FROM はプロバイダで検証済みのドメイン（例: noreply@spotto.fun）を指定。
# TO は CONTACT_INBOX（既定: support@spotto.fun）→ Cloudflare Email Routing が転送。
# ユーザーの返信先は Reply-To に載せる。
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@spotto.fun
RESEND_FROM_NAME=spotto
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@spotto.fun
# SENDGRID_FROM_NAME=spotto
CONTACT_INBOX=support@spotto.fun
SUPPORT_EMAIL=support@spotto.fun

# 利用規約・プライバシーポリシー（外部 URL）
# 設定画面・ログイン同意リンクからアプリ内ブラウザ（iOS: SFSafariViewController）で開きます。
# Notion や自作 LP の公開 URL を設定してください。
EXPO_PUBLIC_TERMS_URL=https://spotto.fun/terms
EXPO_PUBLIC_PRIVACY_URL=https://spotto.fun/privacy

# イベント共有リンクの Web オリジン（未設定時は https://spotto.fun）
# 例: https://spotto.fun → https://spotto.fun/event/{id}
EXPO_PUBLIC_WEB_BASE_URL=https://spotto.fun

# Supabase（画像 Storage・Auth / DB）
# Publishable Key（sb_publishable_...）を EXPO_PUBLIC_SUPABASE_ANON_KEY に設定します。
# 未設定時は端末内 URI のまま保存します。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=event-images
# サーバー専用（絶対に EXPO_PUBLIC_ にしない / アプリに埋め込まない）
# アカウント削除 API・Edge Function で Auth ユーザーを消すために必要
# SUPABASE_SERVICE_ROLE_KEY=
#
# ===== 運営向け: 月次振込管理 =====
# 管理者ユーザー ID（Supabase Auth UUID）をカンマ区切りで指定。
# サーバーが Bearer トークンのユーザーを検証し、一致しなければ 403。
# 運営（振込管理）: Firebase UID をカンマ区切りで指定。
# アプリ設定の開発用「管理者メニューを有効化」で自分の UID を確認できる。
# クライアント表示: EXPO_PUBLIC_ADMIN_USER_IDS / サーバー判定: ADMIN_USER_IDS
# 加えて JWT app_metadata.role=admin、または profiles.is_admin=true でも可。
ADMIN_USER_IDS=
# メニュー表示用（任意。最終権限は必ずサーバー側 ADMIN_USER_IDS 等で再検証）
EXPO_PUBLIC_ADMIN_USER_IDS=
# 振込管理 API（未設定時は EXPO_PUBLIC_API_BASE_URL/admin/payouts）
EXPO_PUBLIC_ADMIN_PAYOUTS_API_URL=
# SQL: supabase/apply_organizer_payouts.sql
#   （organizer_payouts + profiles.is_admin + event_ends_at / Realtime 一式）
#   ※ apply_sales_payout_linkage.sql も同一内容。どちらか一方を SQL Editor で実行。
# 口座の通知用メール列:
#   supabase/apply_organizer_bank_notify_email.sql
#
# 振込完了メール / プッシュ通知:
#   1) supabase/apply_payout_paid_notify.sql を SQL Editor で実行
#   2) Edge Function をデプロイ:
#        supabase functions deploy notify-payout-paid --no-verify-jwt
#   3) Edge Secrets: RESEND_API_KEY, RESEND_FROM_EMAIL（または SENDGRID_*）
#      任意: PAYOUT_NOTIFY_SECRET
#   4) SQL で通知 URL を設定:
#        update public.app_runtime_config
#          set value = 'https://<PROJECT_REF>.supabase.co/functions/v1/notify-payout-paid'
#          where key = 'payout_notify_url';
#        update public.app_runtime_config
#          set value = '<PAYOUT_NOTIFY_SECRET>'
#          where key = 'payout_notify_secret';
#   サーバー側フォールバック用（任意）:
# PAYOUT_NOTIFY_FUNCTION_URL=
# PAYOUT_NOTIFY_SECRET=
#
# 退会（アカウント削除）セットアップ:
#   1) supabase/apply_account_deletion_rls.sql を SQL Editor で実行（RLS + delete_own_app_data）
#   2) Edge Function をデプロイ: supabase functions deploy delete-account
#      または API サーバー（npm run api）+ SUPABASE_SERVICE_ROLE_KEY で POST /account/delete
#   3) profiles / blocks は auth.users 削除時 CASCADE、または削除 API 内で明示 DELETE
#
# 開発用: SNS OAuth をスキップしてダミーログイン（PKCE 調査中など）
# EXPO_PUBLIC_AUTH_MOCK=1
# ブロック機能: supabase/apply_blocks.sql（または migrations/20260318000000_blocks.sql）を
# Supabase Dashboard → SQL Editor で実行してください。
# （public.blocks + RLS + schema reload。未適用だと PGRST205 が出ますが、端末ローカルのブロックは動作します）
#
# イベント共有: supabase/apply_events.sql（または migrations/20260323120000_events.sql）を
# SQL Editor で実行してください。作成イベントは public.events に保存され、全ユーザーが閲覧できます。
#
# チャット同期: apply_events.sql のあと supabase/apply_chat_messages.sql を実行。
#   Dashboard → Database → Replication で chat_messages が Realtime 対象かも確認。
#
# 参加同期: apply_events.sql のあと supabase/apply_event_participants.sql を実行。
#   event_participants + profiles 閲覧ポリシー + joined_count 同期トリガー。
#   Firebase Auth 利用時は supabase/apply_event_participants_firebase_rls.sql も実行
#   （auth.uid → requesting_user_id、user_id を text 化、text=uuid 比較を解消）。
#   「参加の登録に失敗しました」/ text = uuid = RLS または型不一致。コンソールの
#   [eventParticipants] join failed を確認。
#
# お気に入り同期: apply_events.sql のあと supabase/apply_event_favorites.sql を実行。
#   event_favorites（user_id + event_id）。退会時 delete_own_app_data でも削除。
#
# 本番向け RLS 総点検: supabase/apply_rls_hardening.sql を SQL Editor で実行。
#   events / event_participants / chat_messages / event_favorites / blocks / profiles
#   + device_push_tokens（Expo Push トークン）。監査は supabase/rls_audit.sql。
#   マイグレーション: migrations/20260327120000_device_push_tokens.sql
#
# ブロック: supabase/apply_blocks.sql（既にあれば再実行可）。anon revoke 含む。
#
# 画像 Storage: supabase/apply_storage.sql で event-images バケット＋ポリシーを作成。
#   バケットは Public（public=true）必須。チャット吹き出しの Image は認証なし GET。
#   EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET 未設定時は event-images。
#   アイコンが出ないときはバケットが Private のまま／anon SELECT 欠落を疑う。
#
# === OAuth（Web / フォールバック）Redirect URLs ===
# ネイティブ（iOS/Android Dev Client）では ID トークン方式が主経路です。
# Web ログイン、またはネイティブ未リンク時のフォールバックでブラウザ OAuth を使います。
#
# 「{"error":"requested path is invalid"}」が出る主な原因:
#   1) Site URL が https://xxxx.supabase.co になっている
#   2) Redirect URLs にアプリの戻り先が入っていない（旧 mysportsapp:// のまま等）
#   3) LINE の Callback URL が /auth/v1/callback ではない
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL（supabase.co 以外）:
#     spotto://auth/callback
#     または http://localhost:8081
#   Redirect URLs に必ず追加:
#     spotto://auth/callback
#     spotto://**
#     exp://**
#     http://localhost:8081/auth/callback
#     http://localhost:8081/**
#
# ログの [auth] oauth redirectTo = の値を Redirect URLs に追加すると確実です。
#
# Google（ネイティブ）: Client IDs に Web / iOS / Android をすべて追加。
#   Authorized redirect URIs（Web OAuth 用）には
#   https://<PROJECT_REF>.supabase.co/auth/v1/callback
#
# Apple（ネイティブ）: Client IDs に Bundle ID（com.spotto.app）を追加。
#   Services ID は Web 用。ネイティブ ID トークンでは不要。
#
# === LINE Login（Custom OAuth2）必須チェック ===
# ネイティブ: LINE SDK → id_token → signInWithIdToken(provider=custom:line)
# ブラウザフォールバック時の症状「Error getting user profile from external provider」:
#   ブラウザ認証は成功したが、Supabase が LINE userinfo を取れないときに出ます。
#
# Supabase Dashboard → Authentication → Providers → New Provider:
#   Configuration method: Manual configuration（OIDC Discovery は使わない）
#   Identifier:           custom:line
#   Client ID:            LINE Login チャネルの「チャネル ID」
#   Client Secret:        同チャネルの「チャネルシークレット」
#                         ※ Messaging API 用チャネルの値を入れないこと
#   Authorization URL:    https://access.line.me/oauth2/v2.1/authorize
#   Token URL:            https://api.line.me/oauth2/v2.1/token
#   Userinfo URL:         https://api.line.me/oauth2/v2.1/userinfo
#                         ※ https://api.line.me/v2/profile は不可
#   Scopes:               openid profile
#                         （email は LINE でメール権限申請後のみ）
#   Allow users without an email: ON  ← これ OFF だと高確率で profile エラー
#   プロバイダを Enable
#
# LINE Developers → LINE Login チャネル → Callback URL:
#   https://<PROJECT_REF>.supabase.co/auth/v1/callback
#   （アプリの spotto:// ではなく、必ず Supabase の /auth/v1/callback）
#
# アプリ側の既定スコープは openid profile。email も取る場合のみ:
# EXPO_PUBLIC_LINE_OAUTH_SCOPES=openid profile email
EXPO_PUBLIC_LINE_OAUTH_SCOPES=
#
# リダイレクト上書き（通常は不要。例: spotto://auth/callback）
# OAuth 戻り先（どちらか一方で上書き可）
# 完全 URL 例: spotto://auth/callback / com.spotto.app://auth/callback / com.spotto.app.dev://auth/callback
# EXPO_PUBLIC_AUTH_REDIRECT_URL=spotto://auth/callback
# スキームのみ例（path は auth/callback 固定）: com.spotto.app.dev
# EXPO_PUBLIC_AUTH_SCHEME=com.spotto.app
# 未設定時は app.config の scheme（先頭の利用可能値）→ bundle id → spotto
# Supabase Redirect URLs に `<scheme>://auth/callback` または `<scheme>://**` を追加すること
# LINE Developers の Callback URL は https://<PROJECT>.supabase.co/auth/v1/callback
EXPO_PUBLIC_AUTH_REDIRECT_URL=
EXPO_PUBLIC_AUTH_SCHEME=
# OAuth ブラウザ待ちの上限（ミリ秒）。未設定は 180000（3分）。
# 0 または infinite でタイムアウトなし（ユーザーがブラウザを閉じるまで待つ）
# EXPO_PUBLIC_OAUTH_BROWSER_TIMEOUT_MS=180000
EXPO_PUBLIC_OAUTH_BROWSER_TIMEOUT_MS=
# 既定はコード側で custom:line。別 identifier のときだけ設定（例: custom:line-login）
# ※ line だけを書くと custom:line に正規化されます（ビルトイン line は存在しない）
# EXPO_PUBLIC_SUPABASE_LINE_PROVIDER=custom:line
EXPO_PUBLIC_SUPABASE_LINE_PROVIDER=
# ===== サーバー専用（EXPO_PUBLIC を付けない。アプリには入りません）=====
# npm run api で server/index.mjs が読みます。
# Stripe Secret は上の STRIPE_SECRET_KEY_TEST / STRIPE_SECRET_KEY_LIVE を使用
# （互換: STRIPE_SECRET_KEY= も可）
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# メール送信は上記「お問い合わせメール送信」の RESEND_* / SENDGRID_* を参照
CRON_SECRET=
PORT=8787

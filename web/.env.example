# アプリと同じ Supabase 公開キー（anon / publishable）。service_role は置かない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firebase Web アプリ（Firebase Console のウェブアプリ設定）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# LINE Login（Firebase Custom Token 連携。Supabase の /auth/v1/callback は使わない）
# LINE Developers → LINE Login → Callback URL に次を登録:
#   https://app.spotto.fun/auth/line/callback
#   http://localhost:3456/auth/line/callback
NEXT_PUBLIC_LINE_CHANNEL_ID=
# 省略可。未設定時はブラウザの origin + /auth/line/callback
# NEXT_PUBLIC_LINE_REDIRECT_URI=https://app.spotto.fun/auth/line/callback

# 既存の spotto-api（server/index.mjs）。末尾スラッシュなし。
NEXT_PUBLIC_API_BASE_URL=https://spotto-api-rupy.onrender.com
# 正規の Web アプリ URL（canonical / sitemap / 決済 return / 共有）
NEXT_PUBLIC_SITE_URL=https://app.spotto.fun

# Stripe.js 用の公開可能キー（sk_ はサーバーだけ）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps JavaScript API（マップ表示用。Maps JavaScript API を有効化）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Universal Links。Apple Developer の Team ID と、Play アプリ署名の SHA-256。
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=

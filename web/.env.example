# アプリと同じ Supabase 公開キー（anon / publishable）。service_role は置かない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firebase Web アプリ（Firebase Console のウェブアプリ設定）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 既存の spotto-api（server/index.mjs）。末尾スラッシュなし。
NEXT_PUBLIC_API_BASE_URL=https://spotto-api-rupy.onrender.com
NEXT_PUBLIC_SITE_URL=https://spotto.fun

# Stripe.js 用の公開可能キー（sk_ はサーバーだけ）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Universal Links。Apple Developer の Team ID と、Play アプリ署名の SHA-256。
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=

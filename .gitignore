# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Firebase ネイティブ設定（コンソールからダウンロード。秘密情報を含む場合あり）
google-services.json
GoogleService-Info.plist

# Firebase Admin SDK サービスアカウント（絶対にコミットしない）
server/secrets/
*-firebase-adminsdk-*.json

# API の予約リマインド用ローカル保存
server/data/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
